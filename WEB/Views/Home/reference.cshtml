@{
    ViewData["Title"] = "Reference";
}

<main class="reference-page">
    <div class="reference-hero">
        <span class="reference-badge">Zkušenosti klientů</span>
        <h2>Reference a hodnocení</h2>
        <p>
            Přehled výsledků a přínosů, které trénink přinesl v různých oblastech běžecké přípravy.
        </p>
    </div>

    <div class="reference-grid">
        <article class="reference-card">
            <div class="reference-card-top">
                <div class="reference-icon">📋</div>
                <div>
                    <h3>Tréninkový plán</h3>
                    <p>Výrazné zlepšení výkonu a lepší struktura tréninků.</p>
                </div>
            </div>
            <div class="reference-rating">
                <span class="rating-label">Hodnocení</span>
                <span class="stars">★★★★★</span>
            </div>
        </article>

        <article class="reference-card">
            <div class="reference-card-top">
                <div class="reference-icon">🏃</div>
                <div>
                    <h3>Technika běhu</h3>
                    <p>Zlepšení stylu běhu a ekonomiky pohybu.</p>
                </div>
            </div>
            <div class="reference-rating">
                <span class="rating-label">Hodnocení</span>
                <span class="stars">★★★★☆</span>
            </div>
        </article>

        <article class="reference-card">
            <div class="reference-card-top">
                <div class="reference-icon">🔥</div>
                <div>
                    <h3>Kondice</h3>
                    <p>Vyšší vytrvalost a lepší rychlost.</p>
                </div>
            </div>
            <div class="reference-rating">
                <span class="rating-label">Hodnocení</span>
                <span class="stars">★★★★★</span>
            </div>
        </article>

        <article class="reference-card">
            <div class="reference-card-top">
                <div class="reference-icon">💪</div>
                <div>
                    <h3>Regenerace</h3>
                    <p>Menší únava a rychlejší zotavení.</p>
                </div>
            </div>
            <div class="reference-rating">
                <span class="rating-label">Hodnocení</span>
                <span class="stars">★★★★☆</span>
            </div>
        </article>

        <article class="reference-card">
            <div class="reference-card-top">
                <div class="reference-icon">🎯</div>
                <div>
                    <h3>Celkový přístup</h3>
                    <p>Individuální přístup a vysoká motivace.</p>
                </div>
            </div>
            <div class="reference-rating">
                <span class="rating-label">Hodnocení</span>
                <span class="stars">★★★★★</span>
            </div>
        </article>
    </div>
</main>

<section class="back-section">
    <a asp-controller="Home" asp-action="Index" class="back-button">
        ← Zpět na hlavní stránku
    </a>
</section>