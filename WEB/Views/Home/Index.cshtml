@{
    ViewData["Title"] = "Atletika – Běh";
}

<main class="home-page">
    <section class="home-hero">
        <div class="home-hero-content">
            <span class="home-badge">Atletika • Běh • Trénink</span>
            <h2>Atletika – Běh</h2>
            <p class="home-hero-text">
                Vítejte na mém webu o atletice. Najdete zde přehled běžeckých disciplín,
                předzávodní rozcvičku, tréninkové základy i zajímavé světové rekordy.
            </p>

            <div class="home-buttons">
                <a asp-controller="Home" asp-action="Plan" class="home-btn primary-btn">Tréninkový plán</a>
                <a asp-controller="Home" asp-action="Reference" class="home-btn secondary-btn">Reference</a>
            </div>
        </div>

        <div class="home-hero-cards">
            <div class="hero-mini-card">
                <span class="hero-mini-icon">🏃</span>
                <h3>Běžecké disciplíny</h3>
                <p>Sprinty, střední tratě, dlouhé tratě i překážky.</p>
            </div>

            <div class="hero-mini-card">
                <span class="hero-mini-icon">🔥</span>
                <h3>Rozcvička</h3>
                <p>Připravenost před závodem je základ dobrého výkonu.</p>
            </div>

            <div class="hero-mini-card">
                <span class="hero-mini-icon">🏆</span>
                <h3>Rekordy</h3>
                <p>Inspirace od světových atletů a jejich časů.</p>
            </div>
        </div>
    </section>

    <section class="home-info-grid">
        <article class="home-card">
            <div class="card-icon">ℹ️</div>
            <h3>Úvod</h3>
            <p>
                Vítejte na mém webu o atletice. Najdete zde základní informace o běžeckých disciplínách,
                tréninku a světových rekordech.
            </p>
        </article>

        <article class="home-card">
            <div class="card-icon">👤</div>
            <h3>O mně</h3>
            <p>
                Jmenuji se Adam a atletika je můj koníček. Nejvíce se věnuji středním a dlouhým tratím.
            </p>
        </article>

        <article class="home-card">
            <div class="card-icon">🏃</div>
            <h3>Běžecké disciplíny</h3>
            <ul class="styled-list">
                <li>Sprint (60–400 m)</li>
                <li>Střední tratě (800–1500 m)</li>
                <li>Dlouhé tratě (3000–10 000 m)</li>
                <li>Překážkový běh</li>
            </ul>
        </article>

        <article class="home-card">
            <div class="card-icon">⚡</div>
            <h3>Předzávodní rozcvička</h3>
            <ul class="styled-list">
                <li>10 minut lehký klus</li>
                <li>Dynamický strečink</li>
                <li>Atletická abeceda</li>
                <li>Zrychlované rovinky 4×100 m</li>
                <li>Psychická příprava</li>
            </ul>
        </article>

        <article class="home-card home-card-wide">
            <div class="card-icon">📈</div>
            <h3>Trénink</h3>
            <p>
                Trénink běžce by měl obsahovat rozvoj rychlosti, vytrvalosti i správnou regeneraci.
                Důležitá je také technika běhu, pravidelnost a kvalitní příprava před závodem.
            </p>
        </article>
    </section>

    <section class="records-section">
        <div class="records-header">
            <span class="records-badge">Přehled výkonů</span>
            <h3>Tratě a světové rekordy</h3>
            <p>Ukázka vybraných tratí a známých světových výkonů.</p>
        </div>

        <div class="table-wrapper">
            <table class="records-table">
                <thead>
                    <tr>
                        <th>Trať</th>
                        <th>Typ běhu</th>
                        <th>Jméno</th>
                        <th>Světový rekord</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>800 m</td>
                        <td>Střední trať</td>
                        <td>David Rudisha</td>
                        <td>1:40.91</td>
                    </tr>
                    <tr>
                        <td>1500 m</td>
                        <td>Střední trať</td>
                        <td>Hicham El Guerrouj</td>
                        <td>3:26.00</td>
                    </tr>
                    <tr>
                        <td>3000 m</td>
                        <td>Dlouhá trať</td>
                        <td>Jakob Ingebrigtsen</td>
                        <td>7:17.55</td>
                    </tr>
                    <tr>
                        <td>5000 m</td>
                        <td>Dlouhá trať</td>
                        <td>Joshua Cheptegei</td>
                        <td>12:35.36</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>