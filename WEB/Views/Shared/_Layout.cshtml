<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atletika</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <header>
        <div class="header-container">
            <div class="header-left">
                <img src="~/obrazky/obrazek 2.jpg" alt="Logo" class="header-img">
            </div>
            <div class="header-center">
                <h1>Atletika – Běh</h1>
            </div>
            <div class="header-right">
                <img src="~/obrazky/ingebrigtsen.jpg" alt="Jakob" class="header-img">
            </div>
        </div>
    </header>

    <nav class="menu">
        <ul>
            <li><a href="/">Domů</a></li>
            <li><a href="/Home/Plan">Tréninkový plán</a></li>
            <li><a href="/Home/Reference">Reference</a></li>
            <li><a href="/Home/Kontakt">Kontakt</a></li>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="User" asp-action="Profile" class="auth-btn-menu">Profil</a></li>
                <li><a asp-controller="User" asp-action="Logout" style="color: #ff4d4d;">Odhlásit</a></li>
            }
            else
            {
                <li><a asp-controller="User" asp-action="Login" class="auth-btn-menu">Přihlášení</a></li>
                <li><a asp-controller="User" asp-action="Register" class="auth-btn-menu">Registrace</a></li>
            }
        </ul>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Atletika — Adam</p>
    </footer>

</body>
</html>