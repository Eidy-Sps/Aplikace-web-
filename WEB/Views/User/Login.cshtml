@{
    ViewData["Title"] = "Přihlášení";
}

<div class="auth-box">
    <h2>Přihlášení</h2>

    @if (ViewBag.Error != null)
    {
        <p style="color:red; font-weight:bold; margin-bottom:10px;">@ViewBag.Error</p>
    }

    <form asp-controller="User" asp-action="Login" method="post">
        <input type="email" name="email" class="auth-input" placeholder="Váš Email" required />
        <input type="password" name="password" class="auth-input" placeholder="Heslo" required />
        <button type="submit" class="auth-submit">Vstoupit</button>
    </form>

    <p style="margin-top:15px;">Nemáte účet? <a asp-action="Register" style="color:#ff4d4d;">Zaregistrujte se</a></p>
</div>