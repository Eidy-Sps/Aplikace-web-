@{
    ViewData["Title"] = "Registrace";
}

<div class="auth-box">
    <h2>Registrace</h2>
    @if (ViewBag.Error != null)
    {
        <p style="color:red; font-weight:bold; margin-bottom:10px;">@ViewBag.Error</p>
    }
    <form asp-controller="User" asp-action="Register" method="post">
        <input type="email" name="email" class="auth-input" placeholder="Váš Email" required />
        <input type="password" name="password" class="auth-input" placeholder="Heslo" required />
        <button type="submit" class="auth-submit">Registrovat</button>
    </form>
    <p style="margin-top:15px;">Již máte účet? <a asp-action="Login" style="color:#ff4d4d;">Přihlaste se</a></p>
</div>